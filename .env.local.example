# ============================================================
# Mulbox.ch - przykładowe zmienne środowiskowe
# Skopiuj ten plik do .env.local i uzupełnij własnymi kluczami.
# Plik .env.local NIE może trafić do repo (jest w .gitignore).
# ============================================================

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Resend (https://resend.com) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=powiadomienia@mulbox.ch

# --- Adres bazowy aplikacji ---
# Lokalnie: http://localhost:3000
# Produkcja (Netlify/Vercel): https://mulbox.ch
# WAŻNE: ustaw też Site URL w Supabase → Authentication → URL Configuration
NEXT_PUBLIC_APP_URL=https://mulbox.ch

# ID formularza embeddowanego na stronie /kontakt (zostaw puste żeby ukryć sekcję)
NEXT_PUBLIC_CONTACT_FORM_ID=

# --- (opcjonalnie) globalna reCAPTCHA dla formularza /kontakt ---
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
# Webhook secret – Stripe Dashboard → Webhooks → endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxx
# Price IDs – Stripe Dashboard → Products → danej ceny → Price ID
STRIPE_PRICE_PERSONAL=price_xxxx
STRIPE_PRICE_BUSINESS=price_xxxx
